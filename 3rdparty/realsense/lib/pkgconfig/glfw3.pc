prefix=/home/determ/Determ/Library/realsense
exec_prefix=${prefix}
includedir=/home/determ/Determ/Library/realsense/include
libdir=/home/determ/Determ/Library/realsense/lib

Name: GLFW
Description: A multi-platform library for OpenGL, window and input
Version: 3.3.0
URL: https://www.glfw.org/
Requires.private:  x11
Libs: -L${libdir} -lglfw3
Libs.private:  -lrt -lm -ldl
Cflags: -I${includedir}
